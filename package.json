{
  "name": "deepak-textiles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deepak Textiles - Wholesale B2B E-Commerce Platform",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "next dev -p 3000",
    "dev:server": "node --watch server/index.js",
    "build": "next build",
    "start": "node server/index.js",
    "start:client": "next start -p 3000",
    "seed": "node server/seed/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "mongoose": "^8.9.5",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "mongodb-memory-server": "^10.1.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17"
  }
}
